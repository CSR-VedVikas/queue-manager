# Copy to .env for local development. Never commit the real .env.
ENV=development
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/queue_manager
JWT_SECRET=dev-only-change-me
CORS_ORIGINS=http://localhost:5173
# Optional: extra allowed origins as an anchored regex (e.g. Vercel preview URLs)
# CORS_ORIGIN_REGEX=^https://frontend(-[a-z0-9-]+)?-yourteam\.vercel\.app$
# Optional: turns on AI summaries on the dashboard (Claude Fable 5.2)
# ANTHROPIC_API_KEY=
